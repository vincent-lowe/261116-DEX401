#%RAML 1.0
title: American Flights API
version: v1

types:
  AmericanFlight: !include exchange_modules/68ef9520-24e9-4cf2-b2f5-620025690913/training-american-flight-data-type/1.0.1/AmericanFlightDataType.raml

/flights:
  description: A collection of flight records
  get:
    displayName: Get Flights
    description: Retrieve a set of flight records
    queryParameters:
      destination?:
        enum:
          - SFO
          - LAX
          - CLE
    responses:
      200:
        body:
          application/json:
            type: AmericanFlight[]
            example: !include /exchange_modules/68ef9520-24e9-4cf2-b2f5-620025690913/training-american-flights-example/1.0.1/AmericanFlightsExample.raml
      400:
        body:
          application/json:
            example:
              responseMessage: Bad request Please refer to the documentation
  post:
    description: Create a new flight record with the supplied information
    displayName: Create Flight
    body:
      application/json:
        type: AmericanFlight
        example: !include dataTypes/AmericanFlightExample.raml
    responses:
      201:
        body:
          application/json:
            example:
              responseMessage: Flight record added (not really)
      504:
        body:
          application/json:
            example:
              responseMessage: Backend service unavailable

  /{ID}:
    description: A single flight record matching ID
    get:
      displayName: Get Flight by ID
      description: Retrieve one flight record matching ID
      responses:
        200:
          body:
            application/json:
              type: AmericanFlight
